# ===== TAIO.CLUB RemakeStudio — Mac chạy trên máy, KHÔNG cần API key =====
DEPLOY_PROFILE=mac_local
DEMO_MODE=0
PORT=8000

# Chép lời (Whisper chạy trên máy)
HF_WHISPER_MODEL=openai/whisper-large-v3-turbo
# Bỏ dấu # để dùng PhoWhisper cho video tiếng Việt (L3, L4) — tải thêm ~3 GB lần đầu
# HF_WHISPER_MODEL_VI=vinai/PhoWhisper-medium
HF_WHISPER_DEVICE=auto
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Dịch (Qwen3 chạy trên máy). Máy dưới 16 GB RAM: đổi thành qwen3:4b
# ollama  : macOS 14 trở lên
# llamacpp: macOS 13 (Ollama không hỗ trợ), dùng llama.cpp server, cùng model Qwen3 bản nén Q4_K_M
LLM_BACKEND=llamacpp
LLM_BASE_URL=http://127.0.0.1:8102/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local
LLAMACPP_PORT=8102
LLAMACPP_MODEL_PATH=

# Giọng Việt (VieNeu-TTS server chạy trên máy, cổng 8101 để không trùng app ở 8000)
VIENEU_BASE_URL=http://127.0.0.1:8101/v1
VIENEU_MODEL=vieneu-v3-turbo
VIENEU_FORMAT=wav
VIENEU_SPEED_VIA_FFMPEG=1
# onnx (CPU, mặc định) | pytorch (dùng nếu onnxruntime không cài được trên macOS 13)
VIENEU_BACKEND=onnx
# Thư mục chứa repo VieNeu-TTS đã clone (setup script tự tạo)
VIENEU_DIR=../taio-engines/VieNeu-TTS

# Giọng nước ngoài + nhân bản (OmniVoice chạy trong app)
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=auto

# Tách nhạc
DEMUCS_MODEL=htdemucs

# ===== Chế độ worker cho bản Render (giai đoạn 2-3, để trống khi chỉ chạy trên máy) =====
# GATEWAY_URL=https://taio-remakestudio.onrender.com
# WORKER_TOKEN=chuoi-bi-mat-dai-it-nhat-32-ky-tu
# DOORBELL_URL=https://ntfy.sh/<ten-chu-de-bi-mat>
