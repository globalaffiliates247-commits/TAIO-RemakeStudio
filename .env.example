# Cấu hình Cổng máy chủ
PORT=8000

# Khóa API Chép lời & Dịch thuật
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here

# Giọng đọc TTS
VOXCPM_SERVER_URL=http://localhost:8001/v1/audio/speech
VOXCPM_API_KEY=your_voxcpm_api_key_here
FPT_AI_API_KEY=your_fpt_ai_key_here
OMNIVOICE_SERVER_URL=http://localhost:8080/v1/audio/speech
