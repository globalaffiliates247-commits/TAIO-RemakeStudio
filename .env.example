# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Render Deploy Hook (Nếu muốn kích hoạt tự động qua webhook)
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy
